{
  "kind": "collectionType",
  "collectionName": "quiz_questions",
  "info": {
    "singularName": "quiz-question",
    "pluralName": "quiz-questions",
    "displayName": "QuizQuestion"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "questionText": {
      "type": "text",
      "required": true
    },
    "optionA": {
      "type": "string",
      "required": true
    },
    "optionB": {
      "type": "string",
      "required": true
    },
    "optionC": {
      "type": "string",
      "required": true
    },
    "optionD": {
      "type": "string",
      "required": true
    },
    "correctAnswer": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "A",
        "B",
        "C",
        "D"
      ]
    },
    "quiz": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::quiz.quiz",
      "inversedBy": "questions"
    }
  }
}
